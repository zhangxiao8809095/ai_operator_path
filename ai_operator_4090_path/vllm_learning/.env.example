# Hugging Face model ID or a local model directory.
VLLM_MODEL=Qwen/Qwen2.5-1.5B-Instruct

# RTX 4090 single-GPU defaults.
VLLM_DTYPE=auto
VLLM_TENSOR_PARALLEL_SIZE=1
VLLM_GPU_MEMORY_UTILIZATION=0.85
VLLM_MAX_MODEL_LEN=4096
VLLM_SEED=42
VLLM_TRUST_REMOTE_CODE=false

# OpenAI-compatible server/client settings.
VLLM_HOST=127.0.0.1
VLLM_PORT=8000
VLLM_API_KEY=local-token
VLLM_SERVED_MODEL_NAME=vllm-lab
